# =============================================================================
# contractor-mistakes example stack — demo environment variables
# =============================================================================

# --- Facebook Marketing API (required) ---
FB_APP_ID=
FB_APP_SECRET=
FB_ACCESS_TOKEN=

# --- Anthropic (required for drift interpretation and Excel ingestion) ---
ANTHROPIC_API_KEY=

# --- Budget guardrails (optional) ---
# This template declares ~$450/day total, which exceeds the cap below — demonstrating
# cap-exceeded detection in plan/apply output.
ACCOUNT_BUDGET_CAP=400
# ISO 4217 currency code for budget display. Defaults to USD.
CURRENCY=USD
