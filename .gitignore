# Environment
.env

# Customer workspaces contain local stack templates, state, and credentials.
customers/

# Local AI assistant configuration
.claude/

# State lock files (state JSON files are committed; lock files are not)
state/*.lock

# Email bot — pending state awaiting operator GO/HOLD
customers/**/state/.pending_*

# OAuth credentials (never commit)
customers/*/.gmail_token

