# =============================================================================
# AdCode — root .env.example
# Copy to .env and fill in values. Stack-level .env files override these.
# =============================================================================

# --- Facebook Marketing API (required for MCP engine) ---
FB_APP_ID=
FB_APP_SECRET=
FB_ACCESS_TOKEN=
FB_ACCOUNT_ID=

# --- Anthropic (required for Excel ingestion, policy validation, drift interpretation) ---
ANTHROPIC_API_KEY=

# --- Budget guardrails (optional) ---
# Hard cap in whole dollars; plan/apply will block if the stack exceeds this.
ACCOUNT_BUDGET_CAP=
# ISO 4217 currency code for budget display. Defaults to USD.
CURRENCY=USD

# --- Email mailroom (optional — only needed when running integrations/email_mailroom) ---
# Secret token Cloudflare Email Worker sends in X-Webhook-Secret header.
WEBHOOK_SECRET=
# Email address that receives forwarded valid templates.
OPERATOR_EMAIL=
# From-address the bot uses when replying to senders.
BOT_EMAIL=traffic@example.com
# Resend API key for outbound email delivery.
RESEND_API_KEY=
