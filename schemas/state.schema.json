{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://adcode/schemas/state.schema.json",
  "title": "AdCode State File",
  "description": "Written by traffic.py after a push. Maps campaign/adset/ad names to Facebook-assigned IDs.",
  "type": "object",
  "required": ["account_id", "last_pushed_at", "campaigns"],
  "additionalProperties": false,
  "properties": {
    "account_id": {
      "type": "string",
      "pattern": "^act_[0-9]+$"
    },
    "last_pushed_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of the last successful push."
    },
    "campaigns": {
      "type": "object",
      "description": "Keys are campaign names matching the campaign definition JSON.",
      "additionalProperties": { "$ref": "#/definitions/campaign_state" }
    }
  },
  "definitions": {
    "campaign_state": {
      "type": "object",
      "required": ["fb_id", "params", "ad_sets"],
      "additionalProperties": false,
      "properties": {
        "fb_id": {
          "type": "string",
          "description": "Facebook-assigned campaign ID."
        },
        "params": {
          "type": "object",
          "description": "Snapshot of the campaign params as last pushed."
        },
        "ad_sets": {
          "type": "object",
          "description": "Keys are ad set names.",
          "additionalProperties": { "$ref": "#/definitions/adset_state" }
        }
      }
    },
    "adset_state": {
      "type": "object",
      "required": ["fb_id", "params", "ads"],
      "additionalProperties": false,
      "properties": {
        "fb_id": {
          "type": "string",
          "description": "Facebook-assigned ad set ID."
        },
        "params": {
          "type": "object",
          "description": "Snapshot of the ad set params as last pushed."
        },
        "ads": {
          "type": "object",
          "description": "Keys are ad names.",
          "additionalProperties": { "$ref": "#/definitions/ad_state" }
        }
      }
    },
    "ad_state": {
      "type": "object",
      "required": ["fb_id", "creative_id", "params"],
      "additionalProperties": false,
      "properties": {
        "fb_id": {
          "type": "string",
          "description": "Facebook-assigned ad ID."
        },
        "creative_id": {
          "type": "string",
          "description": "Facebook-assigned AdCreative ID."
        },
        "params": {
          "type": "object",
          "description": "Snapshot of the ad params as last pushed."
        }
      }
    }
  }
}
